# Tipos que este Apache nao reconhece por padrao.
# Sem isso os .webp sao servidos sem Content-Type e sem Cache-Control.
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
  AddType image/svg+xml .svg
</IfModule>

# Compressao de texto (o servidor entregava tudo sem comprimir).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Cache. O padrao do servidor era 30 min para tudo.
# css/js podem durar mais porque tem cache buster (?v=).
# As imagens usam nome fixo, entao 30 dias -- trocar a foto mantendo o
# mesmo nome exige renomear o arquivo ou esperar esse prazo.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp    "access plus 30 days"
  ExpiresByType image/png     "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/css      "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType text/html     "access plus 1 hour"
</IfModule>

# Forca HTTPS. As duas condicoes se combinam com E: basta uma delas
# indicar conexao segura para o redirect nao disparar. Em hospedagem
# compartilhada o TLS as vezes termina num proxy antes do Apache, e ai
# %{HTTPS} vem vazio mesmo sob HTTPS -- quem denuncia e o X-Forwarded-Proto.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>
